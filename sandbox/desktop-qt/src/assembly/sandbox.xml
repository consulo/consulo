<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
    <id>main</id>
    <formats>
        <format>dirHardlink</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <componentDescriptors>
        <componentDescriptor>${project.basedir}/../../distribution/src/platform.base.xml</componentDescriptor>
        <componentDescriptor>${project.basedir}/../../distribution/src/platform.desktop.qt.xml</componentDescriptor>
    </componentDescriptors>

    <fileSets>
        <fileSet>
            <!--consulo.sandbox.boot.directory is set by the os profiles of arch/managment/pom.xml-->
            <directory>${project.basedir}/../../distribution/boot/${consulo.sandbox.boot.directory}/</directory>
            <includes>
                <include>*</include>
            </includes>
            <outputDirectory>Consulo/</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../../distribution/platform/consulo/shared/</directory>
            <includes>
                <include>**</include>
            </includes>
            <outputDirectory>Consulo/platform/buildSNAPSHOT/</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../../distribution/platform/consulo.desktop.qt/shared/</directory>
            <includes>
                <include>**</include>
            </includes>
            <outputDirectory>Consulo/platform/buildSNAPSHOT/</outputDirectory>
        </fileSet>
    </fileSets>

    <dependencySets>
        <dependencySet>
            <!--qtjambi.native.artifactId is set by the os profiles of arch/managment/pom.xml. The native
                libraries are unpacked into the plugin native directory instead of being shipped as a jar:
                qtjambi picks them up off io.qt.library-path-override and skips extracting 100+ mb into a temp
                directory on every start, only to delete it again on exit. Windows ships them under bin-->
            <useStrictFiltering>true</useStrictFiltering>
            <outputDirectory>Consulo/platform/buildSNAPSHOT/modules/consulo.desktop.qt/native</outputDirectory>
            <unpack>true</unpack>
            <unpackOptions>
                <includes>
                    <include>lib/**</include>
                    <include>bin/**</include>
                </includes>
            </unpackOptions>
            <includes>
                <include>io.qtjambi:${qtjambi.native.artifactId}</include>
            </includes>
        </dependencySet>
        <dependencySet>
            <outputDirectory>Consulo/platform/buildSNAPSHOT/plugins/consulo.sandbox.plugin/lib</outputDirectory>
            <unpack>false</unpack>
            <scope>runtime</scope>
            <includes>
                <include>consulo:consulo-sand-language-plugin</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>
