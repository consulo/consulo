<component>
  <!--FIXME [VISTALL] if you update this file - update _mac file too-->
  <!--the qtjambi native artifact is OS specific, it is added by each desktop-qt-* assembly descriptor-->
  <dependencySets>
    <dependencySet>
      <useStrictFiltering>true</useStrictFiltering>
      <outputDirectory>Consulo/platform/buildSNAPSHOT/modules/consulo.desktop.qt/lib</outputDirectory>
      <unpack>false</unpack>
      <includes>
        <include>consulo:consulo-desktop-ide-impl</include>
        <include>consulo:consulo-desktop-qt-ide-impl</include>

        <!--qtjambi is not booted, it belongs to this module and has to sit next to the os native jar that
            each desktop-qt-* assembly descriptor adds here-->
        <include>io.qtjambi:qtjambi</include>
      </includes>
    </dependencySet>

    <dependencySet>
      <useStrictFiltering>true</useStrictFiltering>
      <outputDirectory>Consulo/platform/buildSNAPSHOT/boot</outputDirectory>
      <unpack>false</unpack>
      <scope>runtime</scope>
      <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
      <includes>
        <include>consulo:consulo-container-api</include>
        <include>consulo:consulo-desktop-qt-bootstrap</include>
        <include>consulo:consulo-bootstrap</include>
        <include>consulo:consulo-util-nodep</include>
      </includes>
    </dependencySet>
  </dependencySets>
</component>
